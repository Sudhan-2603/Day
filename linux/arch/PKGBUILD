# Maintainer: Sudhan-2603
# Day for Arch Linux — built from the Tauri app in windows/, which runs on
# Windows and Linux alike.

pkgname=day-git
_pkgname=day
pkgver=0.4.0
pkgrel=1
pkgdesc="Day lives at the top of your screen and keeps an eye on your Claude Code sessions"
arch=('x86_64' 'aarch64')
url="https://github.com/Sudhan-2603/day"
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gtk-layer-shell'
  'libayatana-appindicator'
  'gst-plugins-base'
  'gst-plugins-good'
  'dbus'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'gnome-keyring: store API keys (or any other Secret Service provider)'
  'kwallet: store API keys (or any other Secret Service provider)'
)
makedepends=('git' 'cargo' 'nodejs' 'npm')
provides=("$_pkgname")
conflicts=("$_pkgname")
# makepkg's default LTO and debug flags make the Rust build very slow.
options=('!lto' '!debug')
source=("$_pkgname::git+https://github.com/Sudhan-2603/day.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local v
  v=$(sed -n 's/^version = "\(.*\)"/\1/p' windows/Cargo.toml | head -1)
  printf "%s.r%s.%s" "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm ci
}

build() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$PWD/target"
  # beforeBuildCommand builds the front end and the day-hook relay.
  npx tauri build --no-bundle
}

package() {
  cd "$_pkgname"
  install -Dm755 windows/target/release/day "$pkgdir/usr/bin/day"
  # Found next to the app, then copied into ~/.local/share/day/bin at launch.
  install -Dm755 windows/target/release/day-hook "$pkgdir/usr/bin/day-hook"
  install -Dm644 linux/arch/day.desktop "$pkgdir/usr/share/applications/day.desktop"
  install -Dm644 windows/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/day.png"
  install -Dm644 windows/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/day.png"
  install -Dm644 windows/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/day.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-ASSETS.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ASSETS.md"
}
