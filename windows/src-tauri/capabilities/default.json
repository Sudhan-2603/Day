{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What Day's windows are allowed to do. Everything that touches the OS goes through Day's own commands.",
  "windows": ["island", "settings", "day"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-position",
    "autostart:default"
  ]
}

