{
  "name": "day-windows",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --outDir Releases && node scripts/sync-dist.mjs",
    "build:dist": "tsc --noEmit && vite build --outDir dist",
    "build:releases": "tsc --noEmit && vite build --outDir Releases",
    "preview": "vite preview --outDir Releases",
    "test": "node --import ./tests/setup.mjs --test \"tests/**/*.test.mjs\"",
    "icons": "node scripts/gen-icons.mjs",
    "tauri": "tauri",
    "build:hook": "cargo build --release -p Day-hook",
    "dev:hook": "cargo build --release -p Day-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
